# Copy to .env (in the project root) and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=3000
# Public URL of the web app (used in emails, SEO tags and CORS).
APP_URL=http://localhost:5173
# Extra allowed CORS origins, comma separated (defaults to APP_URL).
# CORS_ORIGINS=

# --- Database & cache ---
MONGO_URI=mongodb://127.0.0.1:27017/klyro
# Optional. Enables caching, Redis rate limits and BullMQ background jobs.
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
# Long random string, e.g. `openssl rand -base64 48`. Required in production.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=.example.com
# Google sign-in (OAuth 2.0 Web client ID from Google Cloud Console). Optional.
GOOGLE_CLIENT_ID=

# --- Email (optional; without SMTP, emails are printed to the server log) ---
# docker compose's Mailpit: SMTP_HOST=127.0.0.1, SMTP_PORT=1025, inbox at http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Klyro <no-reply@klyro.dev>"

# --- AI (optional; features fall back to local heuristics without keys) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Embeddings for related posts (https://www.voyageai.com). Optional.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# --- Search ---
# true = use an Atlas Search index named "posts" (MongoDB Atlas only).
ATLAS_SEARCH=false

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
